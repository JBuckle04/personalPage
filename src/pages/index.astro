---
const name = 'James Buckle'
const role = 'Data and cyber professional'
const location = 'London'
const linkedin = 'https://www.linkedin.com/in/jamesbuckleuk'
const featuredProjects = [
  {
    name: 'Deepfake Detection Orchestration',
    summary: 'Bringing together multiple detection approaches into one practical workflow, with a clear experience for real users.',
    tags: ['Systems Design', 'User Experience', 'Project Management'],
  },
  {
    name: 'Open Cards',
    summary: 'Building a personal revision tool that fits how I learn, rather than forcing me into a generic study workflow.',
    tags: ['Prompt Engineering', 'User Experience', 'Testing'],
  },
  {
    name: 'Resolume Colour Picker',
    summary: 'Creating a simpler control surface for a live-visual API so the tool feels faster and easier to use in real time.',
    tags: ['API', 'Human Computer Interaction', 'Frontend'],
  },
]

---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`Personal site for ${name} - projects, writing, and contact details.`}
    />
    <meta name="theme-color" content="#f5efe7" />
    <title>{name} | Personal Page</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="page-shell">
      <header class="hero">
        <nav class="topbar" aria-label="Primary">
          <a class="brand" href="#home">{name}</a>
          <div class="nav-links">
            <a href="#about">About</a>
            <a href="#work">Work</a>
            <a href="#contact">Contact</a>
          </div>
        </nav>

        <div class="hero-grid" id="home">
          <div class="hero-copy">
            <p class="eyebrow">London / Data / Cyber / Creative tech</p>
            <h1>I work where data, systems and people meet.</h1>
            <p class="lede">
              I’m <strong>{name}</strong>, a {role.toLowerCase()} with a background in live events technology and a growing focus on practical problem solving.
              I like building tools that are useful, thoughtful, and make complex work feel easier to understand.
            </p>

            <div class="actions">
              <a class="button button-primary" href={linkedin} target="_blank" rel="noopener noreferrer">
                Connect on LinkedIn
              </a>
            </div>

            <dl class="meta-list">
              <div>
                <dt>Focus</dt>
                <dd>Data, cybersecurity, and hands-on technical projects</dd>
              </div>
              <div>
                <dt>Location</dt>
                <dd>{location}</dd>
              </div>
              <div>
                <dt>Current</dt>
                <dd>Taking on smaller projects across creative tech and systems design</dd>
              </div>
            </dl>
          </div>
        </div>
      </header>

      <main>
        <section class="content-section" id="about">
          <div class="section-heading">
            <p class="eyebrow">About</p>
            <h2>Technically minded, but always thinking about the human side.</h2>
          </div>
          <p>
            I’m starting my career in data and consulting, with a strong grounding in cybersecurity and a lot of interest in how systems work in the real world. My background in live events technology taught me to think quickly, stay calm under pressure, and care about reliability.
          </p>
          <p>
          My previous work has focused on designing event critical systems and other usability sensitive applications, where a poor layout or slow design can lead to serious disruption. Through iterative development I've built a strong understanding of test driven agile design processes and embrace this approach in the problems I solve.
          </p>
          <p>
            I care about making technology more usable, more transparent, and more useful to the people around it. I’m always happy to talk through new ideas, side projects, or weird little problems worth solving.
          </p>
        </section>

        <section class="content-section" id="work">
          <div class="section-heading">
            <p class="eyebrow">Selected work</p>
          </div>

          <div class="project-grid">
            {featuredProjects.map((project) => (
              <article class="project-card">
                <p class="project-kicker">Project</p>
                <h3>{project.name}</h3>
                <p>{project.summary}</p>
                <ul>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </section>

        <section class="content-section split-section" id="contact">
          <div class="section-heading">
            <p class="eyebrow">Get in touch</p>
            <h2>Always open to a good conversation.</h2>
          </div>

          <div class="contact-card">
            <p>
              I’m always interested in new ideas, useful projects, and people working on interesting problems. Feel free to reach out on LinkedIn.
            </p>
            <div class="contact-links">
              <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </div>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family: 'Red Hat Display', sans-serif;
    color: #1d1d1b;
    background:
      radial-gradient(circle at top left, rgba(166, 128, 84, 0.08), transparent 30%),
      radial-gradient(circle at bottom right, rgba(88, 103, 127, 0.08), transparent 30%),
      #f5efe7;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .page-shell {
    position: relative;
    z-index: 1;
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 26px 0 64px;
  }

  .hero {
    position: relative;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(30, 24, 18, 0.08);
    box-shadow: 0 16px 34px rgba(20, 19, 15, 0.06);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px 10px;
  }

  .brand {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2a2926;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: rgba(29, 29, 27, 0.7);
    font-size: 0.96rem;
  }

  .nav-links a:hover,
  .brand:hover,
  .contact-links a:hover {
    color: #171614;
  }

  .hero-grid {
    display: block;
    padding: 10px 24px 24px;
  }

  .hero-copy {
    padding: clamp(18px, 4vw, 24px) 0 4px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #7f5f3a;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 700;
  }

  h1,
  h2,
  h3 {
    margin: 0;
    font-family: 'Fraunces', serif;
    letter-spacing: -0.04em;
    line-height: 0.96;
    color: #171614;
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(3rem, 7vw, 6rem);
  }

  h2 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    max-width: 13ch;
  }

  h3 {
    font-size: 1.54rem;
  }

  .lede,
  .content-section p,
  .project-card p,
  .contact-card p {
    color: rgba(29, 29, 27, 0.8);
    line-height: 1.7;
    font-size: 1.02rem;
  }

  .lede {
    max-width: 60ch;
    margin: 20px 0 0;
    font-size: 1.12rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(23, 22, 20, 0.12);
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    font-weight: 700;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button-primary {
    background: #1a1a18;
    color: #f6f0e8;
    border-color: transparent;
  }

  .meta-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 0;
  }

  .meta-list div {
    padding-top: 14px;
    border-top: 1px solid rgba(23, 22, 20, 0.12);
  }

  .meta-list dt {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(29, 29, 27, 0.56);
    margin-bottom: 8px;
    font-weight: 700;
  }

  .meta-list dd {
    margin: 0;
    color: #1d1d1b;
    line-height: 1.55;
  }

  .content-section {
    margin-top: 22px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(30, 24, 18, 0.08);
    box-shadow: 0 10px 24px rgba(20, 19, 15, 0.03);
  }

  .section-heading {
    display: grid;
    gap: 10px;
    margin-bottom: 16px;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .project-card {
    border-radius: 20px;
    background: #f6f1ea;
    border: 1px solid rgba(31, 24, 17, 0.08);
    padding: 20px;
  }

  .project-kicker {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(29, 29, 27, 0.58);
    font-weight: 700;
  }

  .project-card h3 {
    margin-top: 12px;
  }

  .project-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 18px 0 0;
    list-style: none;
  }

  .project-card li {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(26, 26, 24, 0.04);
    color: rgba(29, 29, 27, 0.82);
    font-size: 0.82rem;
    border: 1px solid rgba(26, 26, 24, 0.06);
  }

  .split-section {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 20px;
    align-items: start;
  }

  .contact-card {
    border-radius: 20px;
    background: #f6f1ea;
    border: 1px solid rgba(31, 24, 17, 0.08);
    padding: 22px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 20px;
  }

  .contact-links a {
    color: #4a3d2f;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-weight: 600;
  }

  strong {
    color: #201d1a;
    font-weight: 700;
  }

  @media (max-width: 920px) {
    .project-grid,
    .meta-list,
    .split-section {
      grid-template-columns: 1fr;
    }

    .topbar {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .page-shell {
      width: min(100% - 20px, 1120px);
      padding-bottom: 36px;
    }

    .hero-grid,
    .topbar,
    .content-section,
    .contact-card,
    .project-card {
      padding-left: 18px;
      padding-right: 18px;
    }

    .topbar {
      padding-top: 16px;
    }

    h1 {
      font-size: clamp(2.8rem, 16vw, 4.2rem);
    }
  }
</style>
