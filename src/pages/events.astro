---
const name = 'James Buckle'
const linkedin = 'https://www.linkedin.com/in/jamesbuckleuk'
const workImages = [
  ['att.Oujh1AryYEZVEvVi6q2lsgtuOeyHah0UW-pkDsSXB34.jpg', 'Event build'],
  ['att.sg27hBtmE_28FqdToM87Hy3ZZV822ccKMFYHbfSKvns.jpg', 'Production control'],
  ['att.ucRQYqnDL504r7QU3bwXt798C0hRgbnBLz_ZvTErwbs.jpg', 'Backstage'],
  ['cb3bc1e8-653c-41a8-bad6-a76844654d32.jpg', 'Live production'],
  ['IMG_0596.JPEG', 'Event space'],
  ['IMG_1430.JPEG', 'Lighting setup'],
  ['IMG_1718.JPEG', 'Live room'],
  ['IMG_2795.JPEG', 'Stage setup'],
  ['IMG_3375.JPG', 'Lighting rig'],
  ['IMG_3418.JPEG', 'Show preparation'],
  ['IMG_3537.JPEG', 'Live event'],
  ['IMG_3905.JPEG', 'Stage lighting'],
  ['IMG_3920.JPEG', 'Venue setup'],
  ['IMG_4148.JPEG', 'Production floor'],
  ['IMG_4374.JPEG', 'Show environment'],
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${name} - live events portfolio.`} />
    <meta name="theme-color" content="#ffffff" />
    <title>{name} / Live Events</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <header class="header">
        <a href="/events">{name}</a>
        <span>Live events</span>
      </header>

      <main>
        <section class="hero" aria-label="Featured project">
          <img src="/images/DTA_EventManager.jpg" alt="DTA Event Manager interface for live event production" />
        </section>

        <section class="intro" aria-labelledby="intro-title">
          <p class="label">Live events / Audio / Networking</p>
          <h1 id="intro-title">Freelance Events Lighting Technician</h1>
          <p class="intro-copy">I’m {name}, a live events technician, passionate about lighting, rigging and event management.</p>
        </section>

        <section class="carousel-section" aria-labelledby="work-title">
          <div class="section-header">
            <h2 id="work-title">Selected work</h2>
          </div>
          <div class="carousel" aria-label="Selected work images">
            <div class="carousel-track">
              {workImages.map(([image, label], index) => (
                <figure class="carousel-slide">
                  <img src={`/images/${image}`} alt={`${label} from live events work`} loading={index === 0 ? 'eager' : 'lazy'} />
                </figure>
              ))}
            </div>
            <div class="carousel-controls">
              <button type="button" class="carousel-button" data-direction="previous" aria-label="Previous image">←</button>
              <button type="button" class="carousel-button" data-direction="next" aria-label="Next image">→</button>
              <span class="carousel-count" aria-live="polite">01 / {String(workImages.length).padStart(2, '0')}</span>
            </div>
          </div>
        </section>

        <section class="info" aria-labelledby="info-title">
          <div>
            <p class="label">About</p>
            <h2 id="info-title">James Buckle</h2>
          </div>
          <div class="info-copy">
            <p>I'm an experienced live events technician, specialising in lighting and production.</p>
            <p>I bring deep experience in nightlife, working with major artists, leading teams of more than 20 for events attended by 2000+ people.</p>
          </div>
        </section>
      </main>

      <footer>
        <span>{name}</span>
        <span>London, UK</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #fff; color: #111; font-family: 'DM Sans', sans-serif; }
  a { color: inherit; text-decoration: none; }
  .page { width: min(1400px, calc(100% - 48px)); margin: 0 auto; }
  .header, footer { display: flex; justify-content: space-between; gap: 24px; color: #666; font-size: .75rem; }
  .header { padding: 24px 0; border-bottom: 1px solid #e5e5e5; }
  .header a, footer span:first-child { color: #111; font-weight: 500; }
  .hero { margin: 24px 0 0; }
  .hero img { display: block; width: 100%; height: min(68vh, 760px); object-fit: cover; object-position: center; }
  .intro { max-width: 720px; padding: 104px 0 132px; }
  .label { margin: 0 0 24px; color: #777; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2, p { margin-top: 0; }
  h1 { max-width: 700px; margin-bottom: 28px; font-size: clamp(2.8rem, 6vw, 6.5rem); font-weight: 500; letter-spacing: -.065em; line-height: .96; }
  .intro-copy { max-width: 460px; margin-bottom: 0; color: #666; font-size: 1.05rem; line-height: 1.6; }
  .carousel-section { padding: 0 0 132px; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid #111; padding: 16px 0; }
  h2 { margin-bottom: 0; font-size: 1rem; font-weight: 500; letter-spacing: -.02em; }
  .carousel-controls { display: flex; align-items: center; gap: 8px; margin-top: 16px; color: #777; font-size: .75rem; }
  .carousel-button { display: grid; width: 40px; height: 40px; place-items: center; border: 1px solid #111; padding: 0; background: #fff; color: #111; font: inherit; cursor: pointer; }
  .carousel-button:hover { background: #111; color: #fff; }
  .carousel-count { margin-left: 8px; }
  .carousel { overflow: hidden; }
  .carousel-track { display: flex; gap: 20px; overflow-x: auto; padding-bottom: 2px; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-slide { flex: 0 0 min(78vw, 920px); margin: 0; scroll-snap-align: start; }
  .carousel img { display: block; width: 100%; height: min(58vw, 620px); min-height: 300px; object-fit: cover; }
  .info { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; border-top: 1px solid #111; padding: 20px 0 132px; }
  .info h2 { font-size: clamp(2rem, 4vw, 4rem); letter-spacing: -.06em; }
  .info-copy { max-width: 430px; color: #555; line-height: 1.6; }
  .info-copy p { margin-bottom: 20px; }
  .info-copy a { display: inline-block; margin-top: 16px; border-bottom: 1px solid #111; padding-bottom: 3px; color: #111; }
  footer { border-top: 1px solid #e5e5e5; padding: 20px 0 36px; }
  @media (max-width: 700px) {
    .page { width: min(100% - 32px, 1400px); }
    .header { padding: 18px 0; }
    .hero { margin-top: 16px; }
    .hero img { height: 55vh; min-height: 340px; }
    .intro { padding: 72px 0 92px; }
    h1 { font-size: clamp(2.8rem, 13vw, 5rem); }
    .carousel-section { padding-bottom: 92px; }
    .carousel-slide { flex-basis: 88vw; }
    .carousel img { height: 58vw; min-height: 240px; }
    .info { grid-template-columns: 1fr; gap: 48px; padding-bottom: 92px; }
  }
</style>

<script>
  const track = document.querySelector('.carousel-track')
  const originalSlides = track ? Array.from(track.querySelectorAll('.carousel-slide')) : []
  const count = document.querySelector('.carousel-count')
  const gap = 20
  let slideWidth = 0
  let loopWidth = 0

  if (track && originalSlides.length > 0) {
    const before = originalSlides.map((slide) => slide.cloneNode(true))
    const after = originalSlides.map((slide) => slide.cloneNode(true))

    before.forEach((slide) => {
      slide.setAttribute('aria-hidden', 'true')
      track.prepend(slide)
    })
    after.forEach((slide) => {
      slide.setAttribute('aria-hidden', 'true')
      track.append(slide)
    })

    const updateCount = () => {
      if (!count || !slideWidth) return
      const currentIndex = Math.max(0, Math.min(originalSlides.length - 1, Math.round((track.scrollLeft - loopWidth) / slideWidth)))
      count.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(originalSlides.length).padStart(2, '0')}`
    }

    const measure = () => {
      slideWidth = originalSlides[0].getBoundingClientRect().width + gap
      loopWidth = slideWidth * originalSlides.length
      track.scrollLeft = loopWidth
      updateCount()
    }

    measure()
    window.addEventListener('resize', measure)

    track.addEventListener('scroll', () => {
      if (track.scrollLeft >= loopWidth * 2) track.scrollLeft -= loopWidth
      if (track.scrollLeft <= 0) track.scrollLeft += loopWidth
      updateCount()
    })

    document.querySelectorAll('.carousel-button').forEach((button) => {
      button.addEventListener('click', () => {
        const direction = button.dataset.direction === 'next' ? 1 : -1
        track.scrollBy({ left: direction * slideWidth, behavior: 'smooth' })
      })
    })

    let autoplay = window.setInterval(() => {
      track.scrollBy({ left: slideWidth, behavior: 'smooth' })
    }, 4000)

    const pauseAutoplay = () => window.clearInterval(autoplay)
    const resumeAutoplay = () => {
      window.clearInterval(autoplay)
      autoplay = window.setInterval(() => {
        track.scrollBy({ left: slideWidth, behavior: 'smooth' })
      }, 4000)
    }

    track.addEventListener('mouseenter', pauseAutoplay)
    track.addEventListener('mouseleave', resumeAutoplay)
    track.addEventListener('focusin', pauseAutoplay)
    track.addEventListener('focusout', resumeAutoplay)
  }
</script>
