---
const name = 'James Buckle'
const linkedin = 'https://www.linkedin.com/in/jamesbuckleuk'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${name} - live events portfolio.`} />
    <meta name="theme-color" content="#ffffff" />
    <title>{name} / Live Events</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <header class="header">
        <a href="/events">{name}</a>
        <span>Live events</span>
      </header>

      <main>
        <section class="hero" aria-label="Featured project">
          <img src="/images/DTA_EventManager.jpg" alt="DTA Event Manager interface for live event production" />
        </section>

        <section class="intro" aria-labelledby="intro-title">
          <p class="label">Live events / systems / technology</p>
          <h1 id="intro-title">I build tools and systems for live events.</h1>
          <p class="intro-copy">I’m {name}, a live events technologist focused on making complex production work clear, reliable, and easy to use.</p>
        </section>

        <section class="carousel-section" aria-labelledby="work-title">
          <div class="section-header">
            <h2 id="work-title">Selected work</h2>
            <span>01 / 01</span>
          </div>
          <div class="carousel" aria-label="Selected work images">
            <figure>
              <img src="/images/DTA_EventManager.jpg" alt="DTA Event Manager interface" />
              <figcaption>DTA Event Manager</figcaption>
            </figure>
          </div>
        </section>

        <section class="info" aria-labelledby="info-title">
          <div>
            <p class="label">About</p>
            <h2 id="info-title">James Buckle</h2>
          </div>
          <div class="info-copy">
            <p>I design and build event-critical systems, interfaces, and tools for people working under pressure.</p>
            <p>My background is in live events technology, with a focus on practical design, clear information, and dependable systems.</p>
            <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </main>

      <footer>
        <span>{name}</span>
        <span>London, UK</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #fff; color: #111; font-family: 'DM Sans', sans-serif; }
  a { color: inherit; text-decoration: none; }
  .page { width: min(1400px, calc(100% - 48px)); margin: 0 auto; }
  .header, footer { display: flex; justify-content: space-between; gap: 24px; color: #666; font-size: .75rem; }
  .header { padding: 24px 0; border-bottom: 1px solid #e5e5e5; }
  .header a, footer span:first-child { color: #111; font-weight: 500; }
  .hero { margin: 24px 0 0; }
  .hero img { display: block; width: 100%; height: min(68vh, 760px); object-fit: cover; object-position: center; }
  .intro { max-width: 720px; padding: 104px 0 132px; }
  .label { margin: 0 0 24px; color: #777; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2, p { margin-top: 0; }
  h1 { max-width: 700px; margin-bottom: 28px; font-size: clamp(2.8rem, 6vw, 6.5rem); font-weight: 500; letter-spacing: -.065em; line-height: .96; }
  .intro-copy { max-width: 460px; margin-bottom: 0; color: #666; font-size: 1.05rem; line-height: 1.6; }
  .carousel-section { padding: 0 0 132px; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid #111; padding: 16px 0; }
  h2 { margin-bottom: 0; font-size: 1rem; font-weight: 500; letter-spacing: -.02em; }
  .section-header span { color: #777; font-size: .75rem; }
  .carousel figure { margin: 0; }
  .carousel img { display: block; width: 100%; max-height: 720px; object-fit: cover; }
  figcaption { margin-top: 12px; color: #666; font-size: .75rem; }
  .info { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; border-top: 1px solid #111; padding: 20px 0 132px; }
  .info h2 { font-size: clamp(2rem, 4vw, 4rem); letter-spacing: -.06em; }
  .info-copy { max-width: 430px; color: #555; line-height: 1.6; }
  .info-copy p { margin-bottom: 20px; }
  .info-copy a { display: inline-block; margin-top: 16px; border-bottom: 1px solid #111; padding-bottom: 3px; color: #111; }
  footer { border-top: 1px solid #e5e5e5; padding: 20px 0 36px; }
  @media (max-width: 700px) {
    .page { width: min(100% - 32px, 1400px); }
    .header { padding: 18px 0; }
    .hero { margin-top: 16px; }
    .hero img { height: 55vh; min-height: 340px; }
    .intro { padding: 72px 0 92px; }
    h1 { font-size: clamp(2.8rem, 13vw, 5rem); }
    .carousel-section { padding-bottom: 92px; }
    .info { grid-template-columns: 1fr; gap: 48px; padding-bottom: 92px; }
  }
</style>
