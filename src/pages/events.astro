---
const name = 'James Buckle'
const linkedin = 'https://www.linkedin.com/in/jamesbuckleuk'
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={`${name} - live events technology and event systems portfolio.`} />
		<meta name="theme-color" content="#090909" />
		<title>{name} | Live Events</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="site-frame">
			<header class="topbar">
				<a class="wordmark" href="/events">JB <span>/ LIVE EVENTS</span></a>
				<nav aria-label="Primary navigation">
					<a href="#work">Work</a>
					<a href="#approach">Approach</a>
					<a href={linkedin} target="_blank" rel="noopener noreferrer">Contact <span aria-hidden="true">↗</span></a>
				</nav>
			</header>

			<main>
				<section class="hero" aria-labelledby="page-title">
					<div class="hero-image">
						<img src="/images/DTA_EventManager.jpg" alt="Event management interface built for live production workflows" />
						<p class="image-label">LIVE SYSTEMS / 2024</p>
					</div>
					<div class="hero-copy">
						<p class="eyebrow">Live events / systems / experience</p>
						<h1 id="page-title">Making the show<br /><em>work.</em></h1>
						<p class="intro">I’m {name}, a live events technologist focused on the systems, tools, and details that keep complex productions moving.</p>
						<a class="text-link" href="#work">View selected work <span aria-hidden="true">↓</span></a>
					</div>
				</section>

				<section class="work-section" id="work" aria-labelledby="work-title">
					<div class="section-heading">
						<p class="eyebrow">Selected work</p>
						<h2 id="work-title">Tools for the<br />pressure moments.</h2>
					</div>

					<div class="showcase">
						<div class="carousel" aria-label="Project image carousel">
							<div class="carousel-track">
								<figure class="slide">
									<img src="/images/DTA_EventManager.jpg" alt="DTA Event Manager interface" />
									<figcaption><span>01</span> DTA Event Manager</figcaption>
								</figure>
							</div>
							<div class="carousel-footer">
								<span>01 / 01</span>
								<div class="carousel-buttons">
									<button type="button" aria-label="Previous project image" disabled>←</button>
									<button type="button" aria-label="Next project image" disabled>→</button>
								</div>
							</div>
						</div>
						<div class="project-copy">
							<p class="project-number">01 — DTA EVENT MANAGER</p>
							<h3>A calmer control surface for a busy room.</h3>
							<p>Designed around the pace of live production, DTA Event Manager brings the important information forward and keeps the workflow legible when the room is moving fast.</p>
							<dl class="project-details">
								<div><dt>Role</dt><dd>Systems design / UX</dd></div>
								<div><dt>Focus</dt><dd>Clarity under pressure</dd></div>
								<div><dt>Format</dt><dd>Web application</dd></div>
							</dl>
						</div>
					</div>
				</section>

				<section class="approach-section" id="approach" aria-labelledby="approach-title">
					<div class="section-heading">
						<p class="eyebrow">How I work</p>
						<h2 id="approach-title">Quietly obsessive<br />about the details.</h2>
					</div>
					<div class="approach-list">
						<article><span>01</span><h3>Understand the room</h3><p>Start with the people, pressure, and practical constraints around the system.</p></article>
						<article><span>02</span><h3>Make it legible</h3><p>Turn complex information into a surface that can be understood at a glance.</p></article>
						<article><span>03</span><h3>Test in motion</h3><p>Build, test, and refine until the experience holds up when the show is live.</p></article>
					</div>
				</section>
			</main>

			<footer>
				<p>Available for interesting problems in live events and creative technology.</p>
				<a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer">Get in touch <span aria-hidden="true">↗</span></a>
			</footer>
		</div>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { scroll-behavior: smooth; }
	:global(body) { margin: 0; background: #090909; color: #f2f0eb; font-family: 'Manrope', sans-serif; }
	:global(body)::before { position: fixed; inset: 0; z-index: -1; pointer-events: none; content: ''; opacity: .16; background-image: linear-gradient(rgba(255,255,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.07) 1px, transparent 1px); background-size: 80px 80px; mask-image: linear-gradient(to bottom, black, transparent 70%); }
	a { color: inherit; text-decoration: none; }
	.site-frame { width: min(1240px, calc(100% - 48px)); margin: 0 auto; }
	.topbar { display: flex; justify-content: space-between; align-items: center; padding: 28px 0; border-bottom: 1px solid #2a2a2a; font-family: 'DM Mono', monospace; font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; }
	.wordmark { font-weight: 500; }
	.wordmark span { color: #888782; margin-left: 8px; }
	nav { display: flex; gap: 28px; color: #aaa9a4; } nav a:hover, .text-link:hover { color: #e85d3f; }
	.hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr); min-height: 650px; border-bottom: 1px solid #2a2a2a; }
	.hero-image { position: relative; min-height: 520px; margin: 48px 48px 48px 0; overflow: hidden; background: #191919; }
	.hero-image::after { position: absolute; inset: 0; content: ''; background: linear-gradient(135deg, transparent 40%, rgba(0,0,0,.5)); }
	.hero-image img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.12); }
	.image-label { position: absolute; bottom: 20px; left: 20px; z-index: 1; margin: 0; font: .63rem 'DM Mono', monospace; letter-spacing: .08em; color: #fff; }
	.hero-copy { align-self: end; padding: 48px 0 78px; }
	.eyebrow, .project-number { margin: 0 0 20px; color: #e85d3f; font: .65rem 'DM Mono', monospace; letter-spacing: .12em; text-transform: uppercase; }
	h1, h2, h3, p { margin-top: 0; } h1, h2, h3 { font-weight: 600; letter-spacing: -.06em; }
	h1 { margin-bottom: 28px; font-size: clamp(4rem, 8vw, 8.5rem); line-height: .84; }
	h1 em { color: #e85d3f; font-style: normal; }
	.intro { max-width: 380px; margin-bottom: 32px; color: #aaa9a4; font-size: 1rem; line-height: 1.7; }
	.text-link { display: inline-flex; gap: 16px; align-items: center; border-bottom: 1px solid #e85d3f; padding-bottom: 7px; color: #f2f0eb; font: .7rem 'DM Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }
	.work-section, .approach-section { padding: 120px 0; border-bottom: 1px solid #2a2a2a; }
	.section-heading { display: flex; justify-content: space-between; align-items: start; gap: 40px; margin-bottom: 72px; }
	h2 { max-width: 560px; margin: 0; font-size: clamp(3rem, 6vw, 6.5rem); line-height: .88; }
	.showcase { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(280px, .7fr); gap: 72px; align-items: center; }
	.carousel { min-width: 0; } .slide { margin: 0; } .slide img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; filter: grayscale(1); } figcaption, .carousel-footer { display: flex; justify-content: space-between; padding-top: 14px; color: #888782; font: .63rem 'DM Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }
	.carousel-buttons { display: flex; gap: 8px; } button { width: 36px; height: 28px; border: 1px solid #454541; background: transparent; color: #f2f0eb; cursor: pointer; } button:disabled { cursor: default; opacity: .35; }
	.project-copy h3 { max-width: 420px; margin-bottom: 24px; font-size: clamp(2rem, 3.2vw, 3.6rem); line-height: .95; } .project-copy > p:not(.project-number) { max-width: 390px; color: #aaa9a4; line-height: 1.7; }
	.project-details { margin: 48px 0 0; border-top: 1px solid #3a3a38; } .project-details div { display: flex; justify-content: space-between; gap: 12px; padding: 14px 0; border-bottom: 1px solid #2a2a2a; font: .67rem 'DM Mono', monospace; text-transform: uppercase; } dt { color: #777670; } dd { margin: 0; text-align: right; }
	.approach-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; } .approach-list article { border-top: 1px solid #555550; padding-top: 18px; } .approach-list span { color: #e85d3f; font: .7rem 'DM Mono', monospace; } .approach-list h3 { margin: 54px 0 16px; font-size: 1.7rem; } .approach-list p { max-width: 280px; color: #aaa9a4; line-height: 1.6; }
	footer { display: flex; justify-content: space-between; gap: 32px; padding: 36px 0 52px; color: #aaa9a4; font-size: .85rem; } footer p { margin: 0; }
	@media (max-width: 720px) { .site-frame { width: min(100% - 32px, 1240px); } .topbar { align-items: start; } nav { gap: 14px; font-size: .6rem; } .wordmark span { display: none; } .hero, .showcase { display: block; } .hero-image { min-height: 360px; margin: 24px 0 0; } .hero-copy { padding: 58px 0 68px; } h1 { font-size: clamp(4rem, 19vw, 7rem); } .work-section, .approach-section { padding: 80px 0; } .section-heading { display: block; margin-bottom: 48px; } .section-heading h2 { font-size: clamp(3rem, 15vw, 5rem); } .project-copy { padding-top: 56px; } .approach-list { grid-template-columns: 1fr; gap: 42px; } .approach-list h3 { margin-top: 32px; } footer { display: block; } footer .text-link { margin-top: 24px; } }
</style>
