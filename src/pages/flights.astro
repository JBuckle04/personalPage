---
const name = 'James Buckle'

const apiUrl = "https://flighttracker-d6gcdgfycedvc9ek.westus3-01.azurewebsites.net/getFlights"

if (!apiUrl?.startsWith('https://')) {
  throw new Error(
    'PUBLIC_FLIGHTS_API_URL must be an absolute HTTPS URL'
  )
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="Live aircraft around London, processed and enriched through Databricks."
    />

    <meta name="theme-color" content="#f5efe7" />

    <title>Flight Tracker | James Buckle</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&display=swap"
      rel="stylesheet"
    />

    <!-- Leaflet -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
  </head>

  <body>
    <div class="page-shell">

      <!-- HERO -->
      <header class="hero">

        <nav class="topbar" aria-label="Primary">
          <a class="brand" href="/">{name}</a>

          <div class="nav-links">
            <a href="/">Home</a>
            <a href="#tracker">Tracker</a>
            <a href="#about">About</a>
          </div>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">

            <p class="eyebrow">
              Live project / Data engineering
            </p>

            <h1>Flights over London.</h1>

            <p class="lede">
              A live view of aircraft around London, built from
              real-time position data and enriched with route
              information through Databricks.
            </p>

            <div class="tracker-status">

              <span
                id="live-indicator"
                class="live-indicator loading"
              ></span>

              <span id="status-text">
                Loading flight data...
              </span>

              <span class="status-divider"></span>

              <span id="aircraft-count">
                — aircraft
              </span>

              <span class="status-divider"></span>

              <span id="last-updated">
                Waiting for first update
              </span>

            </div>
          </div>
        </div>

      </header>


      <main>

        <!-- TRACKER -->
        <section
          class="content-section tracker-section"
          id="tracker"
        >

          <div class="tracker-heading">

            <div>
              <p class="eyebrow">Live tracker</p>

              <h2>Aircraft nearby.</h2>
            </div>

            <button
              id="refresh-button"
              type="button"
            >
              Refresh
            </button>

          </div>


          <!-- MAP -->
          <div
            id="map"
            role="application"
            aria-label="Map showing aircraft around London"
            style="width: 100%; height: 600px; min-height: 600px;"
          ></div>


          <!-- SELECTED AIRCRAFT -->
          <div
            id="flight-detail"
            class="flight-detail hidden"
          >

            <div class="aircraft-title">

              <p class="project-kicker">
                Selected aircraft
              </p>

              <h3 id="detail-flight">
                —
              </h3>

              <p
                id="detail-airline"
                class="airline"
              >
                —
              </p>

            </div>


            <div class="route">

              <span id="detail-origin">
                —
              </span>

              <span class="route-line">
                →
              </span>

              <span id="detail-destination">
                —
              </span>

            </div>


            <dl class="aircraft-meta">

              <div>
                <dt>ICAO24</dt>
                <dd id="detail-icao">—</dd>
              </div>

              <div>
                <dt>Position</dt>
                <dd id="detail-position">—</dd>
              </div>

            </dl>

          </div>

        </section>


        <!-- ABOUT -->
        <section
          class="content-section split-section"
          id="about"
        >

          <div class="section-heading">

            <p class="eyebrow">
              Behind the project
            </p>

            <h2>
              From aircraft signal to web map.
            </h2>

          </div>


          <div class="about-project">

            <p>
              Aircraft position data is collected, processed
              and enriched with route information before being
              stored in Databricks.
            </p>

            <p>
              A lightweight Flask API running on Azure App
              Service exposes the current aircraft data to this
              page, with caching used to reduce unnecessary
              queries against the data platform.
            </p>

            <ul class="tech-list">
              <li>Databricks</li>
              <li>Python</li>
              <li>Flask</li>
              <li>Azure</li>
              <li>Astro</li>
              <li>Leaflet</li>
            </ul>

          </div>

        </section>

      </main>

    </div>


    <!-- Leaflet JS must load before our code -->
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


    <script
      is:inline
      define:vars={{ apiUrl }}
    >
      let map

      const markers = new Map()

      const POLL_INTERVAL_MS = 30000

      const countElement =
        document.getElementById('aircraft-count')

      const statusElement =
        document.getElementById('status-text')

      const updatedElement =
        document.getElementById('last-updated')

      const refreshButton =
        document.getElementById('refresh-button')

      const liveIndicator =
        document.getElementById('live-indicator')


      // --------------------------------------------------
      // MAP
      // --------------------------------------------------

      function initialiseMap() {

        map = L.map(
          'map',
          {
            zoomControl: true
          }
        ).setView(
          [51.5074, -0.1278],
          9
        )


        L.tileLayer(
          'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          {
            maxZoom: 19,
            attribution:
              '&copy; OpenStreetMap contributors'
          }
        ).addTo(map)


        // Ensures Leaflet recalculates against
        // the final rendered container dimensions.
        setTimeout(
          () => map.invalidateSize(),
          100
        )
      }


      // --------------------------------------------------
      // AIRCRAFT ICON
      // --------------------------------------------------

      function createAircraftIcon(resolved) {

        return L.divIcon({
          className:
            'aircraft-marker-container',

          html: `
            <div class="aircraft-marker ${
              resolved ? '' : 'unresolved'
            }">
              <span>✈</span>
            </div>
          `,

          iconSize:
            [36, 36],

          iconAnchor:
            [18, 18]
        })
      }


      // --------------------------------------------------
      // AIRCRAFT DETAILS
      // --------------------------------------------------

      function selectFlight(flight) {

        const panel =
          document.getElementById(
            'flight-detail'
          )

        panel.classList.remove(
          'hidden'
        )


        document.getElementById(
          'detail-flight'
        ).textContent =
          flight.flight_id ||
          'Unknown aircraft'


        document.getElementById(
          'detail-airline'
        ).textContent =
          flight.airline ||
          'Airline unavailable'


        document.getElementById(
          'detail-origin'
        ).textContent =
          flight.origin ||
          '—'


        document.getElementById(
          'detail-destination'
        ).textContent =
          flight.destination ||
          '—'


        document.getElementById(
          'detail-icao'
        ).textContent =
          flight.icao24 ||
          '—'


        if (
          typeof flight.lat === 'number' &&
          typeof flight.lon === 'number'
        ) {

          document.getElementById(
            'detail-position'
          ).textContent =
            `${flight.lat.toFixed(4)}, ${flight.lon.toFixed(4)}`

        } else {

          document.getElementById(
            'detail-position'
          ).textContent =
            'Unavailable'

        }
      }


      // --------------------------------------------------
      // MARKER UPDATE
      // --------------------------------------------------

      function updateMarkers(flights) {

        const currentAircraft =
          new Set()


        flights.forEach(
          (flight) => {

            if (
              typeof flight.lat !== 'number' ||
              typeof flight.lon !== 'number'
            ) {
              return
            }


            const identifier =
              flight.icao24


            if (!identifier) {
              return
            }


            currentAircraft.add(
              identifier
            )


            const resolved =
              Boolean(
                flight.airline ||
                flight.origin ||
                flight.destination
              )


            const existing =
              markers.get(
                identifier
              )


            // ------------------------------
            // MOVE EXISTING AIRCRAFT
            // ------------------------------

            if (existing) {

              existing.setLatLng([
                flight.lat,
                flight.lon
              ])

              existing.flight =
                flight

              return
            }


            // ------------------------------
            // NEW AIRCRAFT
            // ------------------------------

            const marker =
              L.marker(
                [
                  flight.lat,
                  flight.lon
                ],
                {
                  icon:
                    createAircraftIcon(
                      resolved
                    )
                }
              )


            marker.flight =
              flight


            marker.on(
              'click',
              () => {
                selectFlight(
                  marker.flight
                )
              }
            )


            marker.addTo(
              map
            )


            markers.set(
              identifier,
              marker
            )
          }
        )


        // ------------------------------
        // REMOVE AIRCRAFT NO LONGER SEEN
        // ------------------------------

        for (
          const [icao, marker]
          of markers
        ) {

          if (
            !currentAircraft.has(
              icao
            )
          ) {

            marker.remove()

            markers.delete(
              icao
            )
          }
        }
      }


      // --------------------------------------------------
      // API
      // --------------------------------------------------

      async function loadFlights() {

        statusElement.textContent =
          'Updating...'

        liveIndicator.classList.add(
          'loading'
        )

        refreshButton.disabled =
          true


        try {

          const response =
            await fetch(
              apiUrl,
              {
                method: 'GET',
                headers: {
                  Accept:
                    'application/json'
                }
              }
            )


          if (!response.ok) {

            throw new Error(
              `API returned ${response.status}`
            )
          }


          const data =
            await response.json()


          if (
            !Array.isArray(
              data.flights
            )
          ) {

            throw new Error(
              'Invalid API response'
            )
          }


          updateMarkers(
            data.flights
          )


          countElement.textContent =
            `${data.flights.length} ${
              data.flights.length === 1
                ? 'aircraft'
                : 'aircraft'
            }`


          statusElement.textContent =
            'Live'


          liveIndicator.classList.remove(
            'loading'
          )


          const now =
            new Date()


          updatedElement.textContent =
            `Updated ${
              now.toLocaleTimeString(
                [],
                {
                  hour: '2-digit',
                  minute: '2-digit'
                }
              )
            }`


        } catch (error) {

          console.error(
            'Flight API request failed:',
            error
          )


          statusElement.textContent =
            'Data temporarily unavailable'


          liveIndicator.classList.add(
            'error'
          )


        } finally {

          refreshButton.disabled =
            false

        }
      }


      // --------------------------------------------------
      // START
      // --------------------------------------------------

      window.addEventListener(
        'DOMContentLoaded',
        () => {

          initialiseMap()

          refreshButton.addEventListener(
            'click',
            loadFlights
          )

          loadFlights()

          window.setInterval(
            loadFlights,
            POLL_INTERVAL_MS
          )
        }
      )
    </script>

  </body>
</html>


