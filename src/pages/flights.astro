      );
  }


  /* CARD */

  .content-section {
    margin-top:
      22px;

    padding:
      clamp(
        22px,
        3vw,
        32px
      );

    border-radius:
      24px;

    background:
      rgba(
        255,
        255,
        255,
        0.72
