    padding:
      10px 24px 28px;
  }


  .hero-copy {
    padding:
      clamp(
        18px,
        4vw,
        24px
      )
      0
      4px;
  }


  /* TYPOGRAPHY */

  .eyebrow {
    margin:
      0 0 12px;

    color:
      #7f5f3a;

    font-size:
      0.72rem;

    letter-spacing:
      0.15em;

    text-transform:
      uppercase;

    font-weight:
      700;
  }


  h1,
  h2,
  h3 {
    margin: 0;

    font-family:
      'Fraunces',
      serif;

    letter-spacing:
      -0.04em;

    line-height:
      0.96;

    color:
      #171614;
  }


  h1 {
    max-width:
      12ch;

    font-size:
      clamp(
        3rem,
        7vw,
        6rem
      );
  }


  h2 {
    max-width:
      13ch;

    font-size:
      clamp(
        2rem,
        3.6vw,
        3rem
      );
  }


  h3 {
    font-size:
      1.54rem;
  }


  .lede,
  .about-project p {
    color:
      rgba(
        29,
        29,
        27,
        0.8
      );

    line-height:
      1.7;

    font-size:
      1.02rem;
  }


  .lede {
    max-width:
      60ch;

    margin:
      20px 0 0;

    font-size:
      1.12rem;
  }


  /* STATUS */

  .tracker-status {
    display:
      flex;

    flex-wrap:
      wrap;

    align-items:
      center;

    gap:
