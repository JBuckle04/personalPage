---
const name = 'James Buckle'

const apiUrl = "https://flighttracker-d6gcdgfycedvc9ek.westus3-01.azurewebsites.net/getFlights"

if (!apiUrl?.startsWith('https://')) {
  throw new Error(
    'PUBLIC_FLIGHTS_API_URL must be an absolute HTTPS URL'
  )
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="Data engineering with Databricks, tracking flights around central London"
    />

    <meta name="theme-color" content="#f5efe7" />

    <title>Flight Tracker | James Buckle</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&display=swap"
      rel="stylesheet"
    />

    <!-- Leaflet -->
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
  </head>

  <body>
    <div class="page-shell">

      <header class="hero">
        <nav class="topbar" aria-label="Primary">
          <a class="brand" href="/">{name}</a>

          <div class="nav-links">
            <a href="/">Home</a>
            <a href="#tracker">Tracker</a>
            <a href="#about">About</a>
          </div>
        </nav>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              Live project / Data engineering
            </p>

            <h1>Flights over London.</h1>

            <p class="lede">
              Utilising a combindation of Databricks, Azure App Service and Flask to track aircraft around London.
            </p>

            <div class="tracker-status">
              <span
                id="live-indicator"
                class="live-indicator loading"
              ></span>

              <span id="status-text">
                Loading flight data...
              </span>

              <span class="status-divider"></span>

              <span id="aircraft-count">
                — aircraft
              </span>

              <span class="status-divider"></span>

              <span id="last-updated">
                Waiting for first update
              </span>
            </div>
          </div>
        </div>
      </header>


      <main>

        <section
          class="content-section tracker-section"
          id="tracker"
        >
          <div class="tracker-heading">
            <div>
              <p class="eyebrow">
                Live tracker
              </p>

              <h2>
                Aircraft nearby.
              </h2>
            </div>

            <button
              id="refresh-button"
              type="button"
            >
              Refresh
            </button>
          </div>


          <!--
            Inline height is deliberate.
            Leaflet requires a map container with explicit height.
          -->
          <div
            id="map"
            role="application"
            aria-label="Map showing aircraft around London"
            style="width: 100%; height: 600px; min-height: 600px;"
          ></div>


          <div
            id="flight-detail"
            class="flight-detail hidden"
          >
            <div class="aircraft-title">
              <p class="project-kicker">
                Selected aircraft
              </p>

              <h3 id="detail-flight">
                —
              </h3>

              <p
                id="detail-airline"
                class="airline"
              >
                —
              </p>
            </div>

            <div class="route">
              <span id="detail-origin">
                —
              </span>

              <span class="route-line">
                →
              </span>

              <span id="detail-destination">
                —
              </span>
            </div>

            <dl class="aircraft-meta">
              <div>
                <dt>ICAO24</dt>
                <dd id="detail-icao">—</dd>
              </div>

              <div>
                <dt>Position</dt>
                <dd id="detail-position">—</dd>
              </div>
            </dl>
          </div>
        </section>


        <section
          class="content-section split-section"
          id="about"
        >
          <div class="section-heading">
            <p class="eyebrow">
              Behind the project
            </p>

            <h2>
              From aircraft signal to web map.
            </h2>
          </div>

          <div class="about-project">
            <p>
              Aircraft position data is collected, processed and
              enriched with route information by joining across 2 sources before being stored
              in Databricks.
            </p>

            <p>
              A lightweight Flask API running on Azure App Service
              exposes the current aircraft data to this page, with
              caching used to reduce unnecessary queries against
              the data platform.
            </p>

            <ul class="tech-list">
              <li>Databricks</li>
              <li>Python</li>
              <li>Flask</li>
              <li>Azure</li>
            </ul>
          </div>
        </section>

      </main>
    </div>


    <script
      src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    ></script>


    <script
      is:inline
      define:vars={{ apiUrl }}
    >
      let map

      // Aircraft marker state.
      const markers = new Map()

      // ICAO24 of the currently selected aircraft.
      // null means nothing is currently selected.
      let selectedAircraftId = null

      const POLL_INTERVAL_MS = 30000


      // Approximate airport reference locations.
      const airports = [
        {
          code: 'LHR',
          name: 'London Heathrow',
          lat: 51.4700,
          lon: -0.4543
        },
        {
          code: 'LGW',
          name: 'London Gatwick',
          lat: 51.1537,
          lon: -0.1821
        },
        {
          code: 'STN',
          name: 'London Stansted',
          lat: 51.8893,
          lon: 0.2627
        },
        {
          code: 'LTN',
          name: 'London Luton',
          lat: 51.8740,
          lon: -0.3688
        },
        {
          code: 'LCY',
          name: 'London City',
          lat: 51.5053,
          lon: 0.0553
        }
      ]


      const countElement =
        document.getElementById('aircraft-count')

      const statusElement =
        document.getElementById('status-text')

      const updatedElement =
        document.getElementById('last-updated')

      const refreshButton =
        document.getElementById('refresh-button')

      const liveIndicator =
        document.getElementById('live-indicator')

      const flightDetail =
        document.getElementById('flight-detail')


      // --------------------------------------------------
      // HELPERS
      // --------------------------------------------------

      function flightHasResolvedData(flight) {
        return Boolean(
          flight.airline ||
          flight.origin ||
          flight.destination
        )
      }


      function clearSelection() {
        if (selectedAircraftId) {
          const previousMarker =
            markers.get(selectedAircraftId)

          if (previousMarker?.flight) {
            previousMarker.setIcon(
              createAircraftIcon(
                flightHasResolvedData(
                  previousMarker.flight
                ),
                false
              )
            )

            previousMarker.setZIndexOffset(0)
          }
        }

        selectedAircraftId = null

        flightDetail.classList.add('hidden')
      }


      // --------------------------------------------------
      // MAP
      // --------------------------------------------------

      function initialiseMap() {
        map = L.map(
          'map',
          {
            zoomControl: true
          }
        ).setView(
          [51.5074, -0.1278],
          9
        )


        L.tileLayer(
          'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
          {
            maxZoom: 19,
            attribution:
              '&copy; OpenStreetMap contributors'
          }
        ).addTo(map)


        addAirportMarkers()


        setTimeout(
          () => {
            map.invalidateSize()
          },
          100
        )
      }


      // --------------------------------------------------
      // AIRPORTS
      // --------------------------------------------------

      function createAirportIcon(code) {
        return L.divIcon({
          className:
            'airport-marker-container',

          html: `
            <div class="airport-marker">
              <span class="airport-dot"></span>
              <span class="airport-code">${code}</span>
            </div>
          `,

          iconSize:
            [54, 28],

          iconAnchor:
            [27, 14]
        })
      }


      function addAirportMarkers() {
        airports.forEach(
          (airport) => {
            const marker =
              L.marker(
                [
                  airport.lat,
                  airport.lon
                ],
                {
                  icon:
                    createAirportIcon(
                      airport.code
                    ),

                  keyboard: true,

                  // Keep airports below aircraft markers.
                  zIndexOffset: -500
                }
              )


            marker.bindTooltip(
              `<strong>${airport.code}</strong><br>${airport.name}`,
              {
                direction: 'top',
                offset: [0, -10],
                className:
                  'airport-tooltip'
              }
            )


            marker.addTo(map)
          }
        )
      }


      // --------------------------------------------------
      // AIRCRAFT ICON
      // --------------------------------------------------

      function createAircraftIcon(
        resolved,
        selected = false
      ) {
        const classes = [
          resolved
            ? ''
            : 'unresolved',

          selected
            ? 'selected'
            : ''
        ]
          .filter(Boolean)
          .join(' ')


        return L.divIcon({
          className:
            'aircraft-marker-container',

          html: `
            <div class="aircraft-marker ${classes}">
              <span>✈</span>
            </div>
          `,

          iconSize:
            selected
              ? [44, 44]
              : [36, 36],

          iconAnchor:
            selected
              ? [22, 22]
              : [18, 18]
        })
      }


      // --------------------------------------------------
      // SELECTION
      // --------------------------------------------------

      function selectFlight(flight) {

        // Restore previous selection first.
        if (
          selectedAircraftId &&
          selectedAircraftId !== flight.icao24
        ) {
          const previousMarker =
            markers.get(
              selectedAircraftId
            )

          if (previousMarker?.flight) {
            previousMarker.setIcon(
              createAircraftIcon(
                flightHasResolvedData(
                  previousMarker.flight
                ),
                false
              )
            )

            previousMarker.setZIndexOffset(
              0
            )
          }
        }


        selectedAircraftId =
          flight.icao24


        const selectedMarker =
          markers.get(
            selectedAircraftId
          )


        if (selectedMarker) {
          selectedMarker.setIcon(
            createAircraftIcon(
              flightHasResolvedData(flight),
              true
            )
          )

          selectedMarker.setZIndexOffset(
            1000
          )
        }


        flightDetail.classList.remove(
          'hidden'
        )


        document.getElementById(
          'detail-flight'
        ).textContent =
          flight.flight_id ||
          'Unknown aircraft'


        document.getElementById(
          'detail-airline'
        ).textContent =
          flight.airline ||
          'Airline unavailable'


        document.getElementById(
          'detail-origin'
        ).textContent =
          flight.origin ||
          '—'


        document.getElementById(
          'detail-destination'
        ).textContent =
          flight.destination ||
          '—'


        document.getElementById(
          'detail-icao'
        ).textContent =
          flight.icao24 ||
          '—'


        document.getElementById(
          'detail-position'
        ).textContent =
          typeof flight.lat === 'number' &&
          typeof flight.lon === 'number'
            ? `${flight.lat.toFixed(4)}, ${flight.lon.toFixed(4)}`
            : 'Unavailable'
      }


      // --------------------------------------------------
      // AIRCRAFT SNAPSHOT UPDATE
      // --------------------------------------------------

      function updateMarkers(flights) {

        /*
          Every successful API response is considered the
          authoritative current snapshot.

          Existing aircraft:
            -> position/data updated

          New aircraft:
            -> marker created

          Missing aircraft:
            -> marker removed

          Selected aircraft missing:
            -> selection cleared gracefully
        */

        const currentAircraft =
          new Set()


        flights.forEach(
          (flight) => {

            if (
              typeof flight.lat !== 'number' ||
              typeof flight.lon !== 'number' ||
              !flight.icao24
            ) {
              return
            }


            const identifier =
              flight.icao24


            currentAircraft.add(
              identifier
            )


            const resolved =
              flightHasResolvedData(
                flight
              )


            const selected =
              identifier ===
              selectedAircraftId


            const existing =
              markers.get(
                identifier
              )


            // --------------------------------------------
            // EXISTING AIRCRAFT
            // --------------------------------------------

            if (existing) {

              existing.setLatLng([
                flight.lat,
                flight.lon
              ])


              // Keep the latest API state bound
              // to the marker.
              existing.flight =
                flight


              // Re-render icon so selected state
              // survives legitimate position updates.
              existing.setIcon(
                createAircraftIcon(
                  resolved,
                  selected
                )
              )


              existing.setZIndexOffset(
                selected
                  ? 1000
                  : 0
              )


              // If selected, update its detail panel
              // with the latest position/enrichment too.
              if (selected) {
                updateSelectedFlightDetails(
                  flight
                )
              }


              return
            }


            // --------------------------------------------
            // NEW AIRCRAFT
            // --------------------------------------------

            const marker =
              L.marker(
                [
                  flight.lat,
                  flight.lon
                ],
                {
                  icon:
                    createAircraftIcon(
                      resolved,
                      selected
                    ),

                  zIndexOffset:
                    selected
                      ? 1000
                      : 0
                }
              )


            marker.flight =
              flight


            marker.on(
              'click',
              () => {
                selectFlight(
                  marker.flight
                )
              }
            )


            marker.addTo(map)


            markers.set(
              identifier,
              marker
            )
          }
        )


        // ----------------------------------------------
        // REMOVE AIRCRAFT ABSENT FROM CURRENT SNAPSHOT
        // ----------------------------------------------

        for (
          const [icao, marker]
          of markers
        ) {

          if (
            currentAircraft.has(
              icao
            )
          ) {
            continue
          }


          marker.remove()

          markers.delete(
            icao
          )


          // Selected aircraft has left the tracking
          // area / disappeared from the latest feed.
          if (
            selectedAircraftId ===
            icao
          ) {
            selectedAircraftId =
              null

            flightDetail.classList.add(
              'hidden'
            )
          }
        }
      }


      function updateSelectedFlightDetails(
        flight
      ) {
        document.getElementById(
          'detail-flight'
        ).textContent =
          flight.flight_id ||
          'Unknown aircraft'


        document.getElementById(
          'detail-airline'
        ).textContent =
          flight.airline ||
          'Airline unavailable'


        document.getElementById(
          'detail-origin'
        ).textContent =
          flight.origin ||
          '—'


        document.getElementById(
          'detail-destination'
        ).textContent =
          flight.destination ||
          '—'


        document.getElementById(
          'detail-icao'
        ).textContent =
          flight.icao24 ||
          '—'


        document.getElementById(
          'detail-position'
        ).textContent =
          typeof flight.lat === 'number' &&
          typeof flight.lon === 'number'
            ? `${flight.lat.toFixed(4)}, ${flight.lon.toFixed(4)}`
            : 'Unavailable'
      }


      // --------------------------------------------------
      // API
      // --------------------------------------------------

      async function loadFlights() {

        statusElement.textContent =
          'Updating...'

        liveIndicator.classList.add(
          'loading'
        )

        liveIndicator.classList.remove(
          'error'
        )

        refreshButton.disabled =
          true


        try {

          const response =
            await fetch(
              apiUrl,
              {
                method: 'GET',

                headers: {
                  Accept:
                    'application/json'
                },

                cache:
                  'no-store'
              }
            )


          if (!response.ok) {
            throw new Error(
              `API returned ${response.status}`
            )
          }


          const data =
            await response.json()


          if (
            !Array.isArray(
              data.flights
            )
          ) {
            throw new Error(
              'Invalid API response'
            )
          }


          /*
            IMPORTANT:

            Only successful, valid responses update
            marker state.

            If Azure / Databricks temporarily fails,
            the previous map remains visible instead
            of incorrectly deleting every aircraft.
          */

          updateMarkers(
            data.flights
          )


          countElement.textContent =
            `${data.flights.length} aircraft`


          statusElement.textContent =
            'Live'


          liveIndicator.classList.remove(
            'loading'
          )


          const now =
            new Date()


          updatedElement.textContent =
            `Updated ${
              now.toLocaleTimeString(
                [],
                {
                  hour: '2-digit',
                  minute: '2-digit'
                }
              )
            }`


        } catch (error) {

          console.error(
            'Flight API request failed:',
            error
          )


          /*
            Do NOT clear markers here.

            A failed poll does not mean the aircraft
            have disappeared. It means we don't have
            a trustworthy new snapshot.
          */

          statusElement.textContent =
            'Data temporarily unavailable'


          liveIndicator.classList.remove(
            'loading'
          )


          liveIndicator.classList.add(
            'error'
          )


        } finally {

          refreshButton.disabled =
            false
        }
      }


      // --------------------------------------------------
      // START
      // --------------------------------------------------

      window.addEventListener(
        'DOMContentLoaded',
        () => {

          initialiseMap()


          refreshButton.addEventListener(
            'click',
            loadFlights
          )


          loadFlights()


          window.setInterval(
            loadFlights,
            POLL_INTERVAL_MS
          )
        }
      )
    </script>

  </body>
</html>


<style is:global>

  html {
    scroll-behavior: smooth;
  }


  body {
    margin: 0;
    min-height: 100vh;

    font-family:
      'Red Hat Display',
      sans-serif;

    color:
      #1d1d1b;

    background:
      radial-gradient(
        circle at top left,
        rgba(166, 128, 84, 0.08),
        transparent 30%
      ),
      radial-gradient(
        circle at bottom right,
        rgba(88, 103, 127, 0.08),
        transparent 30%
      ),
      #f5efe7;
  }


  a {
    color: inherit;
    text-decoration: none;
  }


  /* PAGE */

  .page-shell {
    position: relative;
    z-index: 1;

    width:
      min(
        1120px,
        calc(100% - 32px)
      );

    margin:
      0 auto;

    padding:
      26px 0 64px;
  }


  /* HERO */

  .hero {
    position: relative;

    border-radius:
      28px;

    background:
      rgba(
        255,
        255,
        255,
        0.76
      );

    border:
      1px solid
      rgba(
        30,
        24,
        18,
        0.08
      );

    box-shadow:
      0 16px 34px
      rgba(
        20,
        19,
        15,
        0.06
      );

    backdrop-filter:
      blur(10px);

    overflow:
      hidden;
  }


  .topbar {
    display: flex;
    align-items: center;
    justify-content:
      space-between;

    gap:
      16px;

    padding:
      18px 24px 10px;
  }


  .brand {
    font-size:
      0.8rem;

    letter-spacing:
      0.12em;

    text-transform:
      uppercase;

    color:
      #2a2926;

    font-weight:
      700;
  }


  .nav-links {
    display: flex;
    flex-wrap: wrap;

    gap:
      18px;

    color:
      rgba(
        29,
        29,
        27,
        0.7
      );

    font-size:
      0.96rem;
  }


